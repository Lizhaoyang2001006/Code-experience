{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phase_pack_manifest",
  "description": "Local phase pack manifest for formal CN structure sources. One entry per real CIF. Generated CIFs must not be listed here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "entries"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "description": "ISO-8601 date or timestamp; must not affect output hashes."
    },
    "notes": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "id",
          "formula",
          "spacegroup",
          "cell",
          "absorber_sites",
          "absorber_elements",
          "cif_path",
          "cif_sha256",
          "experimental",
          "model_level"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "COD / AMCSD / user / other stable source label."
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "formula": {
            "type": "string",
            "minLength": 1
          },
          "spacegroup": {
            "type": "string",
            "minLength": 1
          },
          "cell": {
            "type": "object",
            "additionalProperties": false,
            "required": ["a", "b", "c", "alpha", "beta", "gamma"],
            "properties": {
              "a": {"type": "number", "exclusiveMinimum": 0},
              "b": {"type": "number", "exclusiveMinimum": 0},
              "c": {"type": "number", "exclusiveMinimum": 0},
              "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
              "beta": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
              "gamma": {"type": "number", "exclusiveMinimum": 0, "maximum": 180}
            }
          },
          "absorber_sites": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "description": "Explicit site labels; never auto-select by occupancy x multiplicity."
          },
          "absorber_elements": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "description": "Elements of absorber_sites, derived from the CIF; every element must be one of the 17 supported absorbers."
          },
          "cif_path": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the phase pack root, e.g. COD/9002763/<sha256>.cif."
          },
          "cif_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "experimental": {
            "type": "boolean",
            "description": "true for experimental CIFs; false for computed structures."
          },
          "model_level": {
            "type": "string",
            "enum": ["crystal_cif", "crystal_edited", "prototype", "cluster"]
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "original_filename": {
            "type": "string",
            "description": "Original file name at import time, for traceability."
          },
          "added_by": {
            "type": "string"
          },
          "added_at": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
