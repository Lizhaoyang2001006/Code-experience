+def apply_p1b_config(args, config: dict[str, Any]):
+    """把 P1b/P5 配置键合并进 argparse.Namespace（CLI 显式值优先）。
+
+    ``args`` 里已有的非默认值（布尔 True / 非 None）不会被配置覆盖；
+    因此两个入口都可以在解析完 CLI 后无条件调用。
+    """
