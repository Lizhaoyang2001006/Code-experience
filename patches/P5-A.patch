+def _load_existing_payloads(outdir: Path) -> dict[str, dict]:
+    """读取 ``<元素>/calibration.json``，供 ``--only`` 增量合并。
+
+    局部重跑只更新所选元素；其余元素从既有逐元素产物恢复，避免把
