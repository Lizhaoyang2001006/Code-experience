+    for el in ELEMENTS:
+        path = outdir / el / "calibration.json"
+        if not path.is_file():
+            continue
+        try:
+            data = json.loads(path.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError) as exc:
+            print(f"[T5] 警告: 跳过无法读取的既有产物 {path}: {exc}",
