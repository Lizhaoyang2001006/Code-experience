+    c_sum = sum(cell_counts.values())
+    if d_sum <= 0 or c_sum <= 0:
+        return False
+    for el in declared:
+        if abs(declared[el] / d_sum - cell_counts[el] / c_sum) > 0.01:
+            return False
+    return True
